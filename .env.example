GROQ_API_KEY=your_actual_key_here
# Optional: override the Groq model used by triage/diagnostic/compliance reasoning.
# GROQ_MODEL=openai/gpt-oss-120b
ASSEMBLYAI_API_KEY=your_actual_assemblyai_key_here
# Set to false for the Streamlit app / any browser-based deployment: the
# browser plays the MP3 itself via st.audio(autoplay=True). Leave true (or
# unset) for scripts/run_voice_loop.py CLI usage, which has no browser.
VOICE_AUTO_PLAY=true